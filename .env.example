# VocabBuilder configuration — copy to .env and edit:   cp .env.example .env
# Values here are read by docker compose (for Caddy) and passed to the app container.
# Never commit .env: it contains secrets.

# ------------------------------------------------------------------ address & HTTPS (Caddy)
# Public domain name pointing at this server (DNS A/AAAA record). Caddy obtains HTTPS certificates
# automatically. For a Tailscale machine use its full *.ts.net name.
VB_DOMAIN=vocab.example.com
# Optional e-mail for the ACME (Let's Encrypt/ZeroSSL) account.
ACME_EMAIL=
# Caddy configuration file. LAN-only (no public domain, Caddy's internal CA): ./deploy/Caddyfile.lan
VB_CADDYFILE=./deploy/Caddyfile
# Public origin of the app, used to check that write requests come from your own pages.
# Usually https:// + VB_DOMAIN. Leave empty to accept the request's Host header.
VB_PUBLIC_ORIGIN=https://vocab.example.com

# ------------------------------------------------------------------ first run & sign-in
# One-time code required to create the owner account. Leave empty to have a random code printed
# in the logs on start (docker compose logs app). It stops working once the account exists.
VB_SETUP_TOKEN=
# Sign-in lifetime: a device is signed out after this many days without use, and in any case
# after VB_SESSION_MAX_DAYS.
VB_SESSION_IDLE_DAYS=30
VB_SESSION_MAX_DAYS=90
# Session cookie "Secure" flag: auto (secure when served over HTTPS — recommended), true, or false.
VB_COOKIE_SECURE=auto

# ------------------------------------------------------------------ Forvo pronunciations
# Your Forvo API key (https://api.forvo.com/). Without a key, study works normally and audio
# falls back to your own recordings or optional device text-to-speech (clearly labelled).
# The key stays on the server and is never sent to browsers.
VB_FORVO_API_KEY=
# API host from your Forvo plan's documentation (examples in Forvo's docs use apifree.forvo.com).
VB_FORVO_API_BASE=https://apifree.forvo.com
# Daily request budget, counting both API lookups and audio plays (Forvo resets at 22:00 UTC).
# Set this to your plan's limit or lower.
VB_FORVO_DAILY_LIMIT=500
VB_FORVO_TIMEOUT_MS=8000

# ------------------------------------------------------------------ legal details (Terms of Service)
# Shown in the Terms of Service at /terms. Empty means the built-in details: Lango LLC, contact@lango.com,
# the laws of the United States of America (shared/legal.ts). See docs/LEGAL.md.
VB_LEGAL_NAME=
VB_LEGAL_EMAIL=
VB_LEGAL_ADDRESS=
VB_LEGAL_GOVERNING_LAW=

# ------------------------------------------------------------------ backups
# Daily verified backups of the SQLite database at VB_BACKUP_TIME in your study timezone.
VB_BACKUPS_ENABLED=true
VB_BACKUP_TIME=03:30
# Grandfather-father-son retention for scheduled backups.
VB_BACKUP_KEEP_DAILY=14
VB_BACKUP_KEEP_WEEKLY=8
VB_BACKUP_KEEP_MONTHLY=12
# Optional passphrase: backups are then encrypted with AES-256-GCM. Store it somewhere safe —
# encrypted backups cannot be restored without it. Recommended when copies leave this server.
VB_BACKUP_PASSPHRASE=
# Optional second directory (another disk/NAS) that receives a verified copy of every backup.
# Mount it in docker-compose.yml (e.g. /mnt/backup-disk/vocabbuilder:/offsite) and set:
# VB_OFFSITE_BACKUP_DIR=/offsite
VB_OFFSITE_BACKUP_DIR=

# ------------------------------------------------------------------ general
# Timezone used until you choose one in Settings (the app then uses your setting for study days,
# streaks and the backup time). TZ also sets the container's log timezone.
VB_DEFAULT_TIMEZONE=UTC
TZ=UTC
# Maximum size of an uploaded vocabulary file (MB). Larger dictionary dumps can be imported with
# the CLI (see docs/DEPLOYMENT.md).
VB_MAX_UPLOAD_MB=25
# debug | info | warn | error
VB_LOG_LEVEL=info

# ------------------------------------------------------------------ fixed by docker-compose.yml
# These are set for the container in docker-compose.yml; change them only when running the app
# outside Docker (npm start).
# NODE_ENV=production
# VB_HOST=0.0.0.0
# VB_PORT=3000
# VB_DATA_DIR=/data
# VB_BACKUP_DIR=/backups
# VB_STATIC_DIR=/app/dist/web
# VB_TRUST_PROXY=1          # trust X-Forwarded-* from Caddy; never enable without a proxy in front

# ------------------------------------------------------------------ advanced (rarely needed)
# Base image for builds and image tag.
# NODE_IMAGE=node:24-bookworm-slim
# VB_IMAGE_TAG=latest
# Folders of data files the app reads, one <lang>.json per language, instead of the ones shipped in the image:
# reading comprehension texts (data/reading), the cells of example sentences named by grammar explanations
# (data/grammar) and the Writing practice sentences (data/writing). A missing grammar file only means explanations
# fall back to their rules; a missing writing file means no Writing in that language. Mount the folder first.
# VB_READING_DIR=/app/data/reading
# VB_GRAMMAR_DIR=/app/data/grammar
# VB_WRITING_DIR=/app/data/writing
# scrypt cost for password hashing (default 131072 = 2^17, OWASP recommendation).
# VB_SCRYPT_N=131072
