# Never send local dependencies, builds, data or secrets to the Docker build.
node_modules
dist
storage
data/runtime
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.env.*
!.env.example
.git
.github
tests
test-results
playwright-report
deploy
docs
*.md
!README.md
